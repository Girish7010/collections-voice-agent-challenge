# Mock STT/LLM/TTS dependency (Appendix B). Copy to .env and adjust if needed.
# Probability [0,1] that a request returns 503 downstream_timeout.
MOCK_FAILURE_RATE=0.20
# Lognormal latency parameters for successful requests (milliseconds).
MOCK_LATENCY_MU=5.7
MOCK_LATENCY_SIGMA=0.60
# Optional delay before returning an injected 503 (default: immediate).
MOCK_FAILURE_LATENCY_MS=0
# Optional RNG seed for reproducible runs; leave empty for random.
MOCK_SEED=
