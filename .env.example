# Mock STT/LLM/TTS dependency (Appendix B). Copy to .env and adjust if needed.
# Probability [0,1] that a request returns 503 downstream_timeout.
MOCK_FAILURE_RATE=0.20
# Lognormal latency parameters for successful requests (milliseconds).
MOCK_LATENCY_MU=5.7
MOCK_LATENCY_SIGMA=0.60
# Optional delay before returning an injected 503 (default: immediate).
MOCK_FAILURE_LATENCY_MS=0
# Optional RNG seed for reproducible runs; leave empty for random.
MOCK_SEED=

# Inference service (app/). All optional; defaults shown.
APP_DEPENDENCY_URL=http://localhost:8001

# Storage for the dead-letter queue and the idempotency ledger.
#   sqlite   = one file per process. Local default; correct for a single process only.
#   dynamodb = shared across tasks; required to run more than one replica.
APP_STORE_BACKEND=sqlite
# sqlite only:
APP_DB_PATH=data/collections.db
# dynamodb only (both table names are required when the backend is dynamodb):
APP_DLQ_TABLE=
APP_LEDGER_TABLE=
APP_AWS_REGION=
# Days a succeeded ledger record is kept; 0 keeps them forever. After this a duplicate
# of the same event_id is treated as new and processed again.
APP_LEDGER_TTL_DAYS=30
# Worker threads for blocking store calls. Must be 1 for sqlite; raise it for dynamodb,
# whose calls are network round-trips.
APP_DB_THREADS=1
APP_MAX_ATTEMPTS=3
APP_BASE_DELAY_S=0.2
APP_MAX_DELAY_S=2.0
APP_ATTEMPT_TIMEOUT_S=2.0
APP_CB_FAILURE_THRESHOLD=0.5
APP_CB_WINDOW=50
APP_CB_MIN_CALLS=20
APP_CB_OPEN_S=10
APP_CB_HALF_OPEN_CALLS=1
APP_MAX_CONCURRENCY=200
APP_LOG_LEVEL=INFO
